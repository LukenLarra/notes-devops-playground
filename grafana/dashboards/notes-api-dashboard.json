{
  "title": "Notes API",
  "version": 1,
  "editable": true,
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "tags": [],
  "panels": [
    {
      "title": "Requests per Second",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(notes_api_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "short", "label": "Requests/s" },
        { "format": "short" }
      ]
    },
    {
      "title": "Request Duration (p99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(notes_api_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "s", "label": "Duration" },
        { "format": "s" }
      ]
    },
    {
      "title": "Active Requests",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "notes_api_active_requests",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "short", "label": "Requests" },
        { "format": "short" }
      ]
    },
    {
      "title": "Status Code Breakdown",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(notes_api_requests_total[1m])",
          "legendFormat": "{{method}} {{path}} - {{status}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "short", "label": "Requests/s" },
        { "format": "short" }
      ]
    }
  ]
}
